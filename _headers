# Cuánto tiempo guarda el navegador cada cosa.
# La tipografía nunca cambia, así que se guarda un año.
# El cielo y las imágenes se guardan una semana: si cambias el video,
# a los visitantes que ya entraron les llega el nuevo en máximo 7 días.

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/sky/*
  Cache-Control: public, max-age=604800

/assets/img/*
  Cache-Control: public, max-age=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
